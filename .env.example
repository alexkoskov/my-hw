# Telegram Bot API credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username

# Optional: Translation API key (if using a paid service)
# TRANSLATOR_API_KEY=

# Optional: Database file path (default: news.db)
# DB_FILE=news.db

# Optional: RSS feed URL
# RSS_URL=https://www.autoevolution.com/rss/tag-Hot+Wheels.xml

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional: throttle (seconds) between consecutive auto-fallback publishes
# in overflow / idle-timeout batches. Skip-first: 1 publish in a batch
# does NOT wait; N publishes wait (N-1) × this value. Default 3600 (1h)
# tames channel burst-spam when several rows fall through to the auto
# path in the same tick. Manual hw_review publish is operator-paced and
# never throttled. Set to 0 to disable the wait entirely.
# FALLBACK_THROTTLE_SECONDS=3600