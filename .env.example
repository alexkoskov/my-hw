# Telegram Bot API credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username

# Optional: Translation API key (if using a paid service)
# TRANSLATOR_API_KEY=

# Optional: Database file path (default: news.db)
# DB_FILE=news.db

# Optional: RSS feed URL
# RSS_URL=https://www.autoevolution.com/rss/tag-Hot+Wheels.xml

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# LLM provider for auto-publish transcreation (Claude primary path).
# Values: claude (default) | gemini. Selecting gemini routes to gemini_transcreation.py.
# LLM_PROVIDER=claude

# Anthropic API key for Claude-based transcreation (when LLM_PROVIDER=claude).
# Without it claude_transcreation cannot run and the bot falls back to Google Translate.
# Format: sk-ant-...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Anthropic model override (default: claude-haiku-4-5).
# Sonnet 4.6 yields higher quality at ~5x cost; Haiku is sufficient per ops demos.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Google Gemini API key (when LLM_PROVIDER=gemini).
# Get one at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (default: gemini-2.5-flash-lite).
# Note: gemini-2.0-flash is NOT in the free tier (limit 0); use *-lite or *-latest.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Timezone for the daily 12:00 МСК cron trigger and human-readable log timestamps.
# Required — startup health check pings the operator if this is not Europe/Moscow.
TZ=Europe/Moscow