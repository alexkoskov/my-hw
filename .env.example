# Telegram Bot API credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username

# Admin chat for ALL operator pings (plan-of-day, [E0XX] alerts, outage
# protocol, dedup review) — never the public channel. Set it explicitly:
# leaving it unset does NOT fail loudly in local-dev configuration. The default
# is the placeholder '@sunny413x', so the bot starts, tries to send to a
# @username the Bot API cannot resolve for a private chat, and you get no
# admin pings at all. Must be the NUMERIC chat_id: the review-button listener
# fail-closes on a non-numeric value (_review_listener_gate_reason) and warns
# at startup ('bad_admin'). Get the number by messaging the bot once and reading
# getUpdates. Also required by watchdog.sh (exits nonzero without it).
TELEGRAM_ADMIN_ID=123456789

# Optional: label prefixed to every admin ping (e.g. "prod") so pings from
# different instances are distinguishable in one admin chat. Empty/unset → no
# prefix. The production label 'prod' additionally requires fail-closed
# startup preflight before database initialization or API calls. Production
# Compose pins this label; changing the local-dev example does not select a
# production database by itself.
# INSTANCE_LABEL=prod

# Telegra.ph API token for publishing article bodies. Auto-provisioned on
# first local-dev run by telegraph_publisher.ensure_access_token. Local token
# persistence uses a private, atomic .env write; keep this file chmod 600 and
# do not use a symlink as its write target. In production Docker it MUST be
# supplied explicitly: startup refuses a missing token instead of creating an
# account or trying to write a secret into the image filesystem.
# TELEGRAPH_ACCESS_TOKEN=your_telegraph_token_here

# Optional for local dev: Database file path (default: news.db).
# Production Compose pins DB_FILE=/data/news.db on the mounted /data volume.
# It requires an existing valid nonempty processed-news ledger and writable
# database/parent directory. Do not bootstrap production by creating an empty DB.
# DB_FILE=news.db

# Optional: singleton lock path (local default: .news_bot.lock next to news_bot.py).
# Production Compose pins /data/.news_bot.lock so the non-root worker can lock
# writable shared state while application code remains root-owned.
# NEWS_BOT_LOCK_FILE=/data/.news_bot.lock

# Optional: path of the heartbeat marker written after every completed tick;
# watchdog.sh reads its mtime. Default ~/.cache/news_bot/last_tick.ts
# (news_bot._record_heartbeat). The container overrides it to /data/last_tick.ts on
# the mounted volume via docker-compose.yml, not via .env.
# HEARTBEAT_FILE=/data/last_tick.ts

# Optional: tiered series/theme pair-rule layer of the cross-source dedup gate.
# Default on; 0/false/no/off → off (only the legacy set-overlap dedup runs).
# DEDUP_SERIES_ENABLED=1

# Optional: inline review buttons under the [E014] «Похож на дубль» admin ping.
# Default OFF; truthy 1/true/yes/on → on (0/false/no/off → off, same grammar as
# DEDUP_SERIES_ENABLED). Set =1 ONLY in the hand-managed PROD .env: the bot token
# is shared prod+test, and only ONE instance may run the get_updates listener
# (a second poller gets HTTP 409). The same flag gates BOTH the background
# listener AND keyboard rendering at the E014 send site, so a flag-off instance
# shows no buttons at all. Requires a NUMERIC TELEGRAM_ADMIN_ID — with a
# non-numeric value the listener refuses to start (fail-closed).
# REVIEW_BUTTONS_ENABLED=1

# Optional: source-formatting parity — bold/italic and list markup carried
# from the article through to the Telegraph page. Default ON; 0/false/no/off
# → off (same grammar as DEDUP_SERIES_ENABLED). ANY OTHER VALUE, including a
# typo like `disabled`, leaves the feature ON — mind that when switching it
# off in a hurry.
# «Off» means flat text: paragraphs publish without inline emphasis. It is
# NOT a byte-for-byte return to the pre-feature output (measured drift
# −0.10 % t-hunted, −1.18 % lamley — the latter is WordPress litter being
# cleaned up).
# The value is read ONCE at process start, so a change needs a container
# restart. Restarts are allowed at any time; each restart recreates the
# in-process daily schedule and immediately replans remaining opportunities.
# SOURCE_FORMATTING_ENABLED=1

# Not env vars — do not add them here, the code never reads them:
#   * the feed list is feeds.json; news_bot.RSS_URL is
#     only the hardcoded fallback used when that file is missing or invalid.
#   * the log level is news_bot.LOG_LEVEL (INFO).

# LLM provider for auto-publish transcreation. Optional.
#
# When unset, the dispatcher auto-selects by API-key presence in priority
# order: openai → claude → gemini → openrouter
# (llm_transcreation._auto_select_by_key_presence;
# no key at all → claude, so the startup check emits the missing-key ping).
# Set LLM_PROVIDER explicitly to override the auto-selection — production
# pins LLM_PROVIDER=openrouter so key presence does not decide.
#
# Values: openai | claude | gemini | openrouter
# LLM_PROVIDER=

# OpenAI API key (highest priority in auto-selection).
# Get one at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model override (default: gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Anthropic API key for Claude (second priority in auto-selection).
# Format: sk-ant-...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Anthropic model override (default: claude-haiku-4-5).
# Sonnet 4.6 yields higher quality at ~5x cost; Haiku is sufficient per ops demos.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Google Gemini API key (third priority in auto-selection).
# Get one at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (default: gemini-2.5-flash-lite).
# Note: gemini-2.0-flash is NOT in the free tier (limit 0); use *-lite or *-latest.
# GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter API key (fourth priority — multi-model gateway).
# One key gives access to Claude / GPT / Gemini / Llama / Mistral / DeepSeek
# and many others. Get one at: https://openrouter.ai/keys
# Either OPENROUTER_API_KEY (canonical) or OPEN_ROUTER_API_KEY (alias) works.
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter model in "provider/model[:variant]" form (e.g.
# openai/gpt-5.4-mini, openai/gpt-5.5, anthropic/claude-haiku-4-5,
# google/gemini-2.5-flash, meta-llama/llama-3.3-70b-instruct:free).
# Browse: https://openrouter.ai/models. Default: openai/gpt-5.4-mini.
# OPENROUTER_MODEL=openai/gpt-5.4-mini

# Optional: OpenRouter base URL override (default: https://openrouter.ai/api/v1).
# The alias OPEN_ROUTER_BASE_URL is also accepted by openrouter_transcreation,
# mirroring the OPENROUTER_API_KEY / OPEN_ROUTER_API_KEY pair. Prefer the canonical
# spelling below; the alias exists only so an old .env keeps working.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: low-balance alert threshold in USD (default 5.0). Once a day the bot
# checks the OpenRouter balance and pings the admin [E019] when it drops below
# this, so you can top up before credits run out and posts get held.
# OPENROUTER_MIN_BALANCE_USD=5

# Wall-clock timezone for log timestamps. It does NOT move the tick: the schedule
# is pinned in news_bot.main with an explicit pytz Europe/Moscow, so the
# bot fires at 10:00 МСК even on a UTC host — and the prod host does run UTC.
# Publish slots are 10:00 / 15:00 / 19:30 МСК
# (compute_publish_slots.DAILY_PUBLISH_TIMES), at most one post per slot.
# Set it anyway: the startup health check logs a WARNING
# and pings the admin when TZ is not Europe/Moscow, so a wrong value means a
# recurring false alarm rather than a wrong schedule.
TZ=Europe/Moscow
