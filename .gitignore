# Environment variables and secrets (CRITICAL - MUST ignore)
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets/
.secrets/
*api-key*
*apikey*
*secret*

# Installer recovery copies (local only)
.codex-config-backups/
.ecc-backups/
# Shared skill aliases are provisioned per environment, never vendored.
/.agents/skills/decision-quality
/.agents/skills/grilling
/.agents/skills/integration-reliability
/.agents/skills/project-progress
/.agents/skills/test-quality

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
.next/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local SQLite database (per-machine; prod/test instances each maintain their own)
news.db
news.db-wal
news.db-shm
news.db-journal

# Logs
*.log
# Only the repo-root log dir is ignored. A bare `logs/` matched at ANY depth and
# silently swallowed work/*/logs/ — the per-feature review and QA trail that every
# decisions.md links to. Narrowed 2026-08-03; see work/SESSION-2026-08-03.md.
/logs/

# Test coverage
.pytest_cache/
coverage/
.coverage
htmlcov/

# Temporary files
tmp/
temp/
*.tmp

# VSCode workspace files (auto-generated, per-machine)
*.code-workspace

# pip artefacts from typo'd commands like `pip install pytz=2024.1`
=*
